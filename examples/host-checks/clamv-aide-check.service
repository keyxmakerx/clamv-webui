# clamv: AIDE check; read-only system, no network, report to /var/log/aide/aide.log.
[Unit]
Description=clamv host check: AIDE
ConditionPathExists=/usr/bin/aide

[Service]
Type=oneshot
ExecStart=/usr/bin/aide --check
StandardOutput=truncate:/var/log/aide/aide.log
StandardError=journal
# 1 to 7 mean differences were found, which is a result, not a failure.
SuccessExitStatus=1 2 3 4 5 6 7
Nice=19
IOSchedulingClass=idle
ProtectSystem=strict
ReadWritePaths=/var/lib/aide /var/log/aide
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
