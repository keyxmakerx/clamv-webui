#!/bin/sh
# Remove what Palisade wrote to this host's firewall (its nft table, its ufw and firewalld rules), and nothing else.
dir=/var/lib/palisade/firewall
. /usr/local/libexec/palisade/firewall-lib
clear_all
printf 'removed %s - -\n' "$(date +%s)" >/run/palisade-firewall/status && mv -f /run/palisade-firewall/status "$dir/status"
exit 0
