#!/bin/sh
# Load Palisade's checked plan through nftables, ufw or firewalld; refuse anything else; roll back unless Palisade confirms.
set -u
dir=/var/lib/palisade/firewall
# Work on root-only copies in the unit's RuntimeDirectory, so Palisade cannot swap files mid-check.
run=/run/palisade-firewall
plan=$run/plan.nft
full=$run/full.nft
status() {
  printf '%s %s %s %s\n' "$1" "$(date +%s)" "$2" "${3:--}" >"$run/status" && mv -f "$run/status" "$dir/status"
}
# Read the plan through one open descriptor, and only if Palisade itself owns that file:
# a link to somebody else's file is never read, however it is swapped.
[ -f "$dir/plan.nft" ] && [ ! -L "$dir/plan.nft" ] || { status refused "-"; exit 1; }
exec 3<"$dir/plan.nft"
owner=$(stat -c %u "$dir")
[ "$owner" != 0 ] && [ "$(stat -L -c '%u %F' /proc/$$/fd/3 2>/dev/null)" = "$owner regular file" ] || { status refused "-"; exit 1; }
head -c 65536 <&3 >"$plan"
exec 3<&-
hash=$(sha256sum "$plan" | cut -d' ' -f1)
# Only the lines Palisade's generator writes: one input chain that lets listed networks reach a port and drops the rest.
allowed='^(  chain input \{|    type filter hook input priority -5; policy accept;|    ct state established,related accept|    iif "lo" accept|    (tcp|udp) dport [0-9]{1,5} ip saddr \{ [0-9./, ]+ \} accept|    (tcp|udp) dport [0-9]{1,5} ip6 saddr \{ [0-9a-f:./, ]+ \} accept|    (tcp|udp) dport [0-9]{1,5} drop|  \})$'
if grep -Evq "$allowed" "$plan"; then
  status refused "$hash"; exit 1
fi
# The plan is the inside of one table: no other tables, no ruleset or file commands, braces never close the table.
if grep -Eqi '(^|[^a-z_-])(table|ruleset|include|define|flush|reset|destroy|delete|insert|replace|add|create|rename|export|import|monitor)([^a-z_-]|$)' "$plan"; then
  status refused "$hash"; exit 1
fi
if ! awk '{ n = gsub(/\{/, "{"); m = gsub(/\}/, "}"); d += n - m; if (d < 0) bad = 1 } END { exit (bad || d != 0) }' "$plan"; then
  status refused "$hash"; exit 1
fi
{ echo "table inet palisade {}"; echo "delete table inet palisade"; echo "table inet palisade {"; cat "$plan"; echo "}"; } >"$full"
# Load it in an empty network namespace first: it must parse and create exactly one table, ours.
tables=$(unshare --net sh -c "nft -f '$full' && nft list tables" 2>/dev/null) || { status refused "$hash"; exit 1; }
[ "$tables" = "table inet palisade" ] || { status refused "$hash"; exit 1; }
. /usr/local/libexec/palisade/firewall-lib
how=$(backend)
prev=$state/applied.nft
rm -f "$dir/confirm"
case "$how" in
  nft) nft_load "$plan" ;;
  ufw) ufw_clear && ufw_load "$plan" ;;
  firewalld) fwd_rich "$plan" >"$run/new.rules" && fwd_each remove "$state/fwd.rules" "" && fwd_each add "$run/new.rules" "" ;;
esac || {
  # Half-written: put the last confirmed plan back the same way.
  case "$how" in
    nft) if [ -s "$prev" ]; then nft_load "$prev"; else nft_clear; fi ;;
    ufw) ufw_clear; [ -s "$prev" ] && ufw_load "$prev" ;;
    firewalld) fwd_each remove "$run/new.rules" ""; fwd_each add "$state/fwd.rules" "" ;;
  esac
  status failed "$hash" "$how"; exit 1
}
status pending "$hash" "$how"
i=0
while [ "$i" -lt 90 ]; do
  if [ "$(cat "$dir/confirm" 2>/dev/null)" = "$hash" ]; then
    case "$how" in
      firewalld)
        fwd_each remove "$state/fwd.rules" --permanent
        fwd_each remove "$state/fwd.rules" ""
        fwd_each add "$run/new.rules" --permanent
        cp "$run/new.rules" "$state/fwd.rules" ;;
    esac
    # One tool at a time: drop what an earlier plan left through another.
    [ "$how" = nft ] || nft_clear
    [ "$how" = ufw ] || ! command -v ufw >/dev/null 2>&1 || ufw_clear
    cp "$plan" "$prev"
    status applied "$hash" "$how"; exit 0
  fi
  sleep 1; i=$((i + 1))
done
case "$how" in
  nft) if [ -s "$prev" ]; then nft_load "$prev"; else nft_clear; fi ;;
  ufw) ufw_clear; [ -s "$prev" ] && ufw_load "$prev" ;;
  firewalld) fwd_each remove "$run/new.rules" ""; fwd_each add "$state/fwd.rules" "" ;;
esac
status rolled_back "$hash" "$how"
exit 1
