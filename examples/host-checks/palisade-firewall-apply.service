# Palisade: load Palisade's checked plan through nftables, ufw or firewalld; one fixed script, no traffic.
[Unit]
Description=Palisade firewall: load Palisade's plan
ConditionPathExists=/usr/local/libexec/palisade/firewall-apply

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/palisade/firewall-apply
TimeoutStartSec=180
ProtectSystem=strict
RuntimeDirectory=palisade-firewall
RuntimeDirectoryMode=0700
StateDirectory=palisade-firewall
StateDirectoryMode=0700
ReadWritePaths=/var/lib/palisade/firewall -/etc/ufw -/lib/ufw -/run
PrivateTmp=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
