#!/bin/sh
# Write what this host's firewall looks like, for Palisade to read; changes nothing.
# Reads nothing from $dir: Palisade owns that folder and could point any name in it at another file.
dir=/var/lib/palisade/firewall
out=$dir/snapshot.txt
tmp=/run/palisade-firewall/snapshot.txt
{
  if command -v nft >/dev/null 2>&1; then
    echo "### nft"
    nft list ruleset 2>&1 | head -c 400000
  else
    echo "### no-nft"
  fi
  echo "### iptables-legacy"
  command -v iptables-legacy-save >/dev/null 2>&1 && iptables-legacy-save 2>/dev/null | grep -v '^#' | head -c 100000
  echo "### ufw"
  command -v ufw >/dev/null 2>&1 && ufw status 2>&1 | head -n 60
  echo "### firewalld"
  command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>&1 | head -n 2
  echo "### selinux"
  command -v getenforce >/dev/null 2>&1 && getenforce 2>&1 | head -n 1
  echo "### listening"
  command -v ss >/dev/null 2>&1 && ss -H -tulpn 2>/dev/null | head -n 500
} >"$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$out"
