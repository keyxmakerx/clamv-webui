# Scrape over the trusted mesh or a private Docker network only.
global:
  scrape_interval: 30s
  evaluation_interval: 30s
rule_files:
  - /etc/prometheus/rules/clamav-alerts.yml
scrape_configs:
  - job_name: clamav-webui
    metrics_path: /metrics
    scheme: http  # https when TLS is on; add tls_config.ca_file for a self-signed cert
    static_configs:
      - targets: ["clamav-webui:8080"]
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/secrets/clamav_metrics_token  # same value as METRICS_TOKEN
    scrape_timeout: 10s
